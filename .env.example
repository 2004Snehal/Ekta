# Neon PostgreSQL
# Get your connection string from: https://neon.tech/
DATABASE_URL=postgresql://username:password@host.neon.tech/database?sslmode=require

# LLM Provider Configuration
# Options: "gemini" or "openai"
LLM_PROVIDER=gemini

# LLM Model Selection
# For Gemini: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
# For OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
LLM_MODEL=gemini-2.0-flash

# Google AI API Key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (optional, only if using OpenAI)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
