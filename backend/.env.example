# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ekta_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-pro

# ── Vanna AI ──────────────────────────────────────────────────────────────────
# Directory where Vanna's ChromaDB knowledge base is persisted
VANNA_CHROMA_PATH=./vanna_chroma_db
VANNA_MODEL_NAME=ekta_nlq

# ── LIDA ──────────────────────────────────────────────────────────────────────
# Max additional insight goals to generate when explore=true
LIDA_MAX_GOALS=3

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ── Self-healing SQL ──────────────────────────────────────────────────────────
# Number of LLM-assisted SQL fix attempts before returning an error
MAX_SQL_RETRIES=2
