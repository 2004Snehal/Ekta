# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, local, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Direct connection URL for DDL operations (ALTER TABLE, CREATE TABLE, etc.)
# Required on Supabase if DATABASE_URL points to the session/transaction pooler,
# since poolers cannot reliably run DDL. Set this to the direct DB URL:
#   Supabase: postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# If unset, DATABASE_URL is used as a fallback (works for direct connections).
# DIRECT_DATABASE_URL=postgresql://user:password@db-host:5432/dbname

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# API key for OpenRouter (or any OpenAI-compatible provider)
# Get from: https://openrouter.ai/keys
# To switch provider/models, edit backend/llm_config.py
LLM_API_KEY=sk-or-v1-your-key-here

# ─── NLQ / RAG settings ───────────────────────────────────────────────────────
# Path where ChromaDB persists the RAG knowledge base
# Default: ./chroma_db  (relative to backend/)
# CHROMA_PATH=./chroma_db

# Max self-healing retries when generated SQL fails to execute
# Default: 2
# MAX_SQL_RETRIES=2

# Max LIDA visualisation goals per explore query
# Default: 3
# LIDA_MAX_GOALS=3
