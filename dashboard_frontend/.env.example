# ─── Backend API ─────────────────────────────────────────────────────────────
# Base URL of the analytics backend (FastAPI / Express / etc.)
# - Local development:  http://localhost:8000
# - Production:         https://your-api.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Optional: Vercel Analytics ──────────────────────────────────────────────
# Automatically enabled on Vercel. No key needed for @vercel/analytics.
# Set to "1" if you want forced-enable in preview deployments.
# VERCEL_ANALYTICS_ID=

# ─── Optional: Authentication (add if you protect the dashboard) ─────────────
# NEXTAUTH_SECRET=replace_with_a_random_32_char_string
# NEXTAUTH_URL=http://localhost:3000
